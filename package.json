    "@tailwindcss/vite": "~4.3.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/three": "~0.187.0",
    "@vitejs/plugin-react": "~6.2.1",
    "draco3dgltf": "^1.5.7",
    "tailwindcss": "~4.3.5",
    "typescript": "5.9.3",
    "vite": "~8.3.6"
  }
